    <!-- Tutorial coach marks -->
    <string name="tutorial_welcome_title">Bienvenido a Chaoscope</string>
    <string name="tutorial_welcome_body">Arrastra en cualquier parte del lienzo para rotar el atractor en 3D. Pellizca para hacer zoom.</string>
    <string name="tutorial_pick_title">Elige un atractor</string>
    <string name="tutorial_pick_body">Desliza la fila de chips para elegir entre 15 atractores extraños — o toca Sorpréndeme para uno al azar.</string>
    <string name="tutorial_tune_title">Ajusta los parámetros</string>
    <string name="tutorial_tune_body">Arrastra cualquier control para remodelar la órbita en tiempo real. Pequeños cambios pueden transformar por completo la imagen.</string>
    <string name="tutorial_render_title">Toca para renderizar</string>
    <string name="tutorial_render_body">El botón ▶ del centro renderiza tu atractor. Para una imagen a resolución completa, usa HD o 4K en la pestaña Exportar.</string>
    <string name="tutorial_palette_title">Cambia la paleta</string>
    <string name="tutorial_palette_body">Cambia los chips de paleta para recolorear al instante — la vista previa se actualiza enseguida. Toca Editar para crear tu propio degradado.</string>
