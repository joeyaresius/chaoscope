<?xml version="1.0" encoding="utf-8"?>
<!--
  Lorenz butterfly icon — two nested oval lobe-sets (left=cyan, right=violet)
  converging at the central crossing point, mirroring the classic Lorenz attractor
  shape. Four stroke levels per lobe (outer→inner) increase in alpha and decrease
  in width to suggest depth/density. A bright white dot marks the saddle centre.

  Lobe geometry:
    Left centre: x=34, right edge at x=54 (the crossing point)
    Right centre: x=74, left edge at x=54 (the crossing point)
    Each level: centre fixed, rx shrinks 20→15→10→5, ry shrinks 15→11→7→4
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dark navy background -->
    <path
        android:fillColor="#080818"
        android:pathData="M0,0h108v108H0z"/>

    <!-- Faint central glow — wide soft ellipse behind the crossing -->
    <path
        android:fillColor="#12182F"
        android:pathData="M18,54 A36,18 0 1,0 90,54 A36,18 0 1,0 18,54"/>

    <!-- ── LEFT LOBE (cyan family) ─────────────────────────────── -->
    <!-- L1 outer  rx=20 ry=15  alpha≈50% -->
    <path
        android:strokeColor="#801A3A6A"
        android:strokeWidth="3.0"
        android:fillColor="@android:color/transparent"
        android:pathData="M14,54 A20,15 0 1,0 54,54 A20,15 0 1,0 14,54"/>
    <!-- L2        rx=15 ry=11  alpha≈65% -->
    <path
        android:strokeColor="#A61565C0"
        android:strokeWidth="2.4"
        android:fillColor="@android:color/transparent"
        android:pathData="M19,54 A15,11 0 1,0 49,54 A15,11 0 1,0 19,54"/>
    <!-- L3        rx=10 ry=7   alpha≈80% -->
    <path
        android:strokeColor="#CC1E88E5"
        android:strokeWidth="1.8"
        android:fillColor="@android:color/transparent"
        android:pathData="M24,54 A10,7 0 1,0 44,54 A10,7 0 1,0 24,54"/>
    <!-- L4 inner  rx=5  ry=4   alpha=100% bright cyan -->
    <path
        android:strokeColor="#FF4FC3F7"
        android:strokeWidth="1.3"
        android:fillColor="@android:color/transparent"
        android:pathData="M29,54 A5,4 0 1,0 39,54 A5,4 0 1,0 29,54"/>

    <!-- ── RIGHT LOBE (violet family) ────────────────────────────── -->
    <!-- R1 outer  rx=20 ry=15  alpha≈50% -->
    <path
        android:strokeColor="#804A1270"
        android:strokeWidth="3.0"
        android:fillColor="@android:color/transparent"
        android:pathData="M54,54 A20,15 0 1,0 94,54 A20,15 0 1,0 54,54"/>
    <!-- R2        rx=15 ry=11  alpha≈65% -->
    <path
        android:strokeColor="#A66A1B9A"
        android:strokeWidth="2.4"
        android:fillColor="@android:color/transparent"
        android:pathData="M59,54 A15,11 0 1,0 89,54 A15,11 0 1,0 59,54"/>
    <!-- R3        rx=10 ry=7   alpha≈80% -->
    <path
        android:strokeColor="#CC8E24AA"
        android:strokeWidth="1.8"
        android:fillColor="@android:color/transparent"
        android:pathData="M64,54 A10,7 0 1,0 84,54 A10,7 0 1,0 64,54"/>
    <!-- R4 inner  rx=5  ry=4   alpha=100% bright lavender -->
    <path
        android:strokeColor="#FFCE93D8"
        android:strokeWidth="1.3"
        android:fillColor="@android:color/transparent"
        android:pathData="M69,54 A5,4 0 1,0 79,54 A5,4 0 1,0 69,54"/>

    <!-- Saddle-point glow ring (faint cyan) -->
    <path
        android:strokeColor="#554FC3F7"
        android:strokeWidth="1.0"
        android:fillColor="@android:color/transparent"
        android:pathData="M47,54 A7,7 0 1,0 61,54 A7,7 0 1,0 47,54"/>

    <!-- Centre dot — bright white -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M51,54 A3,3 0 1,0 57,54 A3,3 0 1,0 51,54"/>

</vector>
