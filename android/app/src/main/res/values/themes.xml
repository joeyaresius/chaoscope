<resources>
    <!-- Base application theme — the Compose theme (ChaoscopeTheme) takes over at runtime -->
    <style name="Theme.Chaoscope" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Transparent system bars for edge-to-edge. On Android 15+ this is the
             enforced default; on older versions it gives us true edge-to-edge without
             calling the now-deprecated Window.set{Status,Navigation}BarColor APIs. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
