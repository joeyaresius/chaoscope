    <string name="tutorial_welcome_title">Bienvenue dans Chaoscope</string>
    <string name="tutorial_welcome_body">Faites glisser n\'importe où sur le canevas pour faire pivoter l\'attracteur en 3D. Pincez pour zoomer.</string>
